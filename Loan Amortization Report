def amortization_schedule(P0, r, k, N):
    # Calculate payment amount
    i = r / k
    n = k * N

    payment = P0 * (i * (1 + i) ** n) / ((1 + i) ** n - 1)

    balance = P0

    print(f"\nLoan Amount: ${P0:,.2f}")
    print(f"Payment Amount: ${payment:,.2f}\n")

    print(f"{'Pmt#':<6}{'Payment':>12}{'Interest':>12}"
          f"{'Principal':>14}{'Balance':>14}")

    for payment_num in range(1, n + 1):
        interest = balance * i
        principal = payment - interest
        balance -= principal

        if balance < 0.01:
            balance = 0

        print(f"{payment_num:<6}"
              f"${payment:>11.2f}"
              f"${interest:>11.2f}"
              f"${principal:>13.2f}"
              f"${balance:>13.2f}")


# Example
P0 = float(input("Amount financed: "))
r = float(input("Annual interest rate (decimal): "))
k = int(input("Compounds per year: "))
N = int(input("Number of years: "))

amortization_schedule(P0, r, k, N)